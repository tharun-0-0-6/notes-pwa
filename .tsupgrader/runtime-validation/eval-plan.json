{
  "projectType": "webapp",
  "devServer": {
    "command": "npm",
    "args": [
      "run",
      "dev",
      "--",
      "--host",
      "127.0.0.1",
      "--port",
      "4174"
    ],
    "url": "http://127.0.0.1:4174/",
    "readyTimeoutSeconds": 120
  },
  "setup": [
    {
      "command": "npm",
      "args": [
        "ci"
      ],
      "timeoutSeconds": 600
    }
  ],
  "assertions": [
    {
      "name": "production-build",
      "kind": "process",
      "command": "npm",
      "args": [
        "run",
        "build"
      ],
      "verificationMethod": "exit-code",
      "expected": "0",
      "timeoutSeconds": 300
    },
    {
      "name": "lint",
      "kind": "process",
      "command": "npm",
      "args": [
        "run",
        "lint"
      ],
      "verificationMethod": "exit-code",
      "expected": "0",
      "timeoutSeconds": 120
    },
    {
      "name": "dev-server-home-200",
      "kind": "http-probe",
      "startCommand": "npm",
      "startArgs": [
        "run",
        "dev",
        "--",
        "--host",
        "127.0.0.1",
        "--port",
        "4175"
      ],
      "url": "http://127.0.0.1:4175/",
      "verificationMethod": "http-status",
      "expected": "200",
      "timeoutSeconds": 120
    }
  ]
}
